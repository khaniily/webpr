                </a>
                <a href="https://www.python.org/" target="_blank" class="tech-item">
                    <img src="img/pn.png" alt="Python">
                    <span>Python</span>
                </a>
                <a href="https://vuejs.org/" target="_blank" class="tech-item">
                    <img src="img/vue.png" alt="VueJS">
                    <span>VueJS</span>
                </a>
                <a href="https://www.postgresql.org/" target="_blank" class="tech-item">
                    <img src="img/sql.png" alt="PostgreSQL">
