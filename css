/*ОБЩЕЕ*/
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {font-family:sans-serif;
    background-color: white;
    color: black;
    line-height: 1.6;
    padding: 40px 20px;
}

.resume {
    max-width: 799px;
    max-height: 1080px;
    margin: 0 auto;
    background-color: white;
    padding: 40px;
}

/*ШАПКА*/
.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
    padding-bottom: 25px;
    border-bottom: 1px solid gray; 
}

.profile-info {
    display: flex;
    align-items: center;
    gap: 20px;
}

.avatar {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px ;
}

.profile-text h1 {
    font-size: 24px;
    margin-bottom: 5px;
}

.profile-text p {
    color: black;
    font-size: 14px;
}

.contact-info {
    text-align: right;
}

.contact-info h2 {
    font-size: 24px;
    margin-bottom: 10px;
}

.contact-info p {
    font-size: 17px;
    color: black;
}

/*ОБО МНЕ*/
.about {
    margin-bottom: 30px;
    font-size: 14px;
    text-align: justify;
}

/*ХОББИ И СОЦСЕТИ*/
.info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border: 2px solid green;
    border-radius: 6px;
    margin-bottom: 40px;
}

.info-box:first-child {
    border-right: 2px solid green;
}

.info-box h3 {
    font-size: 14px;
    color: green;
    font-weight: 700;
    text-align: center;
    padding: 12px 15px;
    border-bottom: 2px solid green;
    margin-bottom: 12px;
}

.info-box ul {
    padding-left: 35px;
    font-size: 14px;
}

/*СОЦСЕТИ*/
.social-list {
    list-style: decimal;
    padding-left: 55px;
    font-size: 14px;
}

.social-list li {
    margin: 6px 0;
}

.social-list a {
    color: black;
    text-decoration: none;
    border-bottom: 2px solid transparent;
}

.social-list a:hover {
    color: green;
    border-bottom-color: green;
}

/*ЗАГОЛОВКИ ХОББИ И СОЦ.СЕТЕЙ*/
.section-title {
    background-color: green;
    color: white;
    font-size: 14px;
    font-weight: 700;
    text-align: center;
    padding: 10px 15px;
    border-radius: 4px;
    margin-bottom: 20px;
}

/*ТЕХНОЛОГИИ*/
.tech-section {
    margin-bottom: 40px;
}

.tech-icons {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
}

.tech-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    border-radius: 12px;
    text-decoration: none;
    color: black;
    border: 2px solid transparent;

}

.tech-item img {
    width: 50px;
    height: 50px;
    object-fit: contain;
}

.tech-item:hover img {
    outline: 2px solid green;
    border-radius: 8px;
    padding: 4px;
}

.tech-item span {
    font-size: 12px;
    font-weight: 400;
}

/*ФОРМА*/
.contact-form-section {
    margin-bottom: 10px;
}

.form-row {
    display: flex;
    gap: 15px;
    margin-bottom: 15px;
}

.contact-form-section input,
.contact-form-section textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid grey;
    border-radius: 4px;
    font-family: sans-serif;
    font-size: 14px;
}

.contact-form-section textarea {
    margin-bottom: 15px;
    resize: vertical;
}

.button {
    background-color: green;
    color: white;
    padding: 12px;
    border-radius: 4px;
    font-size: 14px;
    text-align: center;
    cursor: pointer;
    
}
