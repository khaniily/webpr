function check_number(num){
    if (num > 0) {console.log('положительное')}
    if (num < 0){console.log('отрицательное')}
    if (num == 0){console.log('ноль')}

    if (num % 2 == 0) {console.log('четное')}
    else {console.log('нечетное')} 
}
check_number(5)


const numb = [4, 8, 15, 16, 23, 42];
let summ = 0
let maxx = numb[0]
const bolshe_10 = []
for (let i = 0; i < numb.length; i++) {
    summ = summ + numb[i];
    if (numb[i]>maxx) {
        maxx=numb[i];
    }
    if (numb[i] > 10) {
        bolshe_10.push(numb[i]);
    }
}
console.log("Сумма: ", summ)
console.log("Макс. значение: ", maxx)
console.log("Больше 10: ", bolshe_10)

